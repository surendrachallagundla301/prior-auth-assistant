<configuration>
    <!-- Every log message passes through PhiMaskingConverter, which scrubs member IDs and dates. -->
    <conversionRule conversionWord="maskedMsg"
                    converterClass="com.surendra.priorauth.logging.PhiMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5level [%thread] %logger{36} - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
